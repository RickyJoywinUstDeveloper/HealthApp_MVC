@{
    ViewBag.Title = "Home Page";
}

<div class="container py-5">

    <section class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            Welcome to HealthCare Application
        </h1>
        <p class="lead text-muted">
            Manage your healthcare needs efficiently
        </p>
    </section>

    <div class="row g-4">

        <!-- Patient Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">
                        Patient Management
                    </h5>

                    <p class="card-text text-muted">
                        Manage patient information, medical history, and personal details.
                    </p>

                    <a href="@Url.Action("Index", "Patient")"
                       class="btn btn-primary btn-sm">
                        Go to Patients
                    </a>
                </div>
            </div>
        </div>

        <!-- Doctor Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">
                        Doctor Management
                    </h5>

                    <p class="card-text text-muted">
                        View doctor profiles, specializations, and availability.
                    </p>

                    <a href="@Url.Action("Index", "Doctor")"
                       class="btn btn-success btn-sm">
                        Go to Doctors
                    </a>
                </div>
            </div>
        </div>

        <!-- Appointment Booking -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">
                        Appointment Booking
                    </h5>

                    <p class="card-text text-muted">
                        Schedule and manage your appointments with doctors.
                    </p>

                    <a href="@Url.Action("Index", "Appointment")"
                       class="btn btn-warning btn-sm">
                        Go to Appointments
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>