@model HealthAppMVC.Models.Appointment

@{
    ViewBag.Title = "Delete Appointment";
}

<h2>Delete Appointment</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this appointment?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Patient
    </dt>

    <dd class="col-sm-9">
        @Model.PatientName
    </dd>

    <dt class="col-sm-3">
        Doctor
    </dt>

    <dd class="col-sm-9">
        @Model.DoctorName
    </dd>

    <dt class="col-sm-3">
        Date
    </dt>

    <dd class="col-sm-9">
        @Model.ScheduledDate.ToShortDateString()
    </dd>

</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    @Html.ActionLink(
        "Back",
        "Index",
        null,
        new
        {
            @class =
            "btn btn-secondary"
        })
}