@model HealthAppMVC.Models.Appointment

@{
    ViewBag.Title = "Cancel Appointment";
}

<h2>Cancel Appointment</h2>

<div class="card">
    <div class="card-body">

        <p>
            <strong>Patient:</strong>
            @Model.PatientName
        </p>

        <p>
            <strong>Doctor:</strong>
            @Model.DoctorName
        </p>

        <p>
            <strong>Date:</strong>
            @Model.ScheduledDate.ToShortDateString()
        </p>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Cancellation Reason</label>

                <textarea name="cancellationReason"
                          class="form-control">
                </textarea>
            </div>

            <br />

            <button type="submit"
                    class="btn btn-warning">
                Cancel Appointment
            </button>

            @Html.ActionLink(
                "Back",
                "Index",
                null,
                new
                {
                    @class =
                    "btn btn-secondary"
                })
        }
    </div>
</div>