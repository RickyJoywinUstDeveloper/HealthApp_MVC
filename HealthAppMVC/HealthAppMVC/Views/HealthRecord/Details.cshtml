@model HealthAppMVC.Models.HealthRecord

@{
    ViewBag.Title = "Health Record Details";
}

<h2>Health Record Details</h2>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-md-3">
                Patient
            </dt>

            <dd class="col-md-9">
                @Model.PatientName
            </dd>

            <dt class="col-md-3">
                Doctor
            </dt>

            <dd class="col-md-9">
                @Model.DoctorName
            </dd>

            <dt class="col-md-3">
                Specialisation
            </dt>

            <dd class="col-md-9">
                @Model.Specialisation
            </dd>

            <dt class="col-md-3">
                Visit Date
            </dt>

            <dd class="col-md-9">
                @Model.VisitDate
            </dd>

            <dt class="col-md-3">
                Diagnosis
            </dt>

            <dd class="col-md-9">
                @Model.Diagnosis
            </dd>

            <dt class="col-md-3">
                Prescription
            </dt>

            <dd class="col-md-9">
                @Model.Prescription
            </dd>

            <dt class="col-md-3">
                Notes
            </dt>

            <dd class="col-md-9">
                @Model.Notes
            </dd>

        </dl>

        @Html.ActionLink(
            "Back",
            "History",
            new
            {
                patientId = Model.PatientId
            },
            new
            {
                @class = "btn btn-secondary"
            })
    </div>
</div>